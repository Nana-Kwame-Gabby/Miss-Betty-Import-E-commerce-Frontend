{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/",
      "destination": "/api/seo?route=home"
    },
    {
      "source": "/shop",
      "destination": "/api/seo?route=shop"
    },
    {
      "source": "/shop/:slug",
      "destination": "/api/seo?route=product&slug=:slug"
    },
    {
      "source": "/product/:id",
      "destination": "/api/seo?route=product&slug=:id&legacy=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/media.js": {
      "maxDuration": 60
    }
  }
}
